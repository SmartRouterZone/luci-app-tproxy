config tproxy 'main'
	option enabled '0'

	option prog '/usr/local/bin/mihomo'
	option res_dir '/etc/clash.meta'
	option config_file '/etc/clash.meta/config.yaml'

	option fwmark '1'
	option bypass_mark '255'
	option ipv4_table '100'
	option ipv6_table '101'
	option ipv4_rule_priority '32760'
	option ipv6_rule_priority '32765'
	option route_dev 'lo'

	option nft_file '/tmp/tproxy-port.nft'
	option nft_table_family 'inet'
	option nft_table_name 'TPROXY'
	option divert_chain_name 'divert'
	option prerouting_chain_name 'prerouting'
	option output_chain_name 'output'
	option divert_priority 'mangle - 1'
	option prerouting_priority 'mangle'
	option output_priority 'mangle'
	option tproxy_port '12345'

	option lan_ifaces 'br-lan'
	option bypass_ifaces 'eth0, pppoe-wan, wg'
	option bypass_ports '54321'
	option loopback_iface 'lo'

	option tcp_ports '80, 443, 853, 465, 587, 993, 995'
	option udp_ports '80, 443, 853'
	option proxy_router_output '0'

	option reserved_ipv4 '0.0.0.0/8, 127.0.0.0/8, 172.16.0.0/12, 169.254.0.0/16, 100.64.0.0/10, 10.0.0.0/8, 192.168.0.0/16, 224.0.0.0/4, 240.0.0.0/4, 255.255.255.255'
	option reserved_ipv6 '::/128, ::1/128, ::ffff:0.0.0.0/96, ::ffff:0:0/96, 64:ff9b::/96, 64:ff9b:1::/48, 100::/64, 2001::/32, 2001:20::/28, 2001:db8::/32, 2002::/16, dd88:88:88:88::/64, fc00::/7, fe80::/10, ff00::/8, fd10:10:10:10::/64'

	option enable_divert '1'
	option enable_ipv4 '1'
	option enable_ipv6 '1'
	option enable_udp '1'
	option enable_tcp '1'
	option bypass_reserved_ip '1'
	option bypass_wan_iface '1'
	option bypass_wg_iface '1'
	option bypass_wg_server_port '1'

	option respawn_threshold '3600'
	option respawn_timeout '5'
	option respawn_retry '3'
