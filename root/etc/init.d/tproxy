#!/bin/sh /etc/rc.common

START=96
STOP=88
USE_PROCD=1

CONFIG=tproxy

extra_command "core_version" "Show mihomo kernel version"
extra_command "logs" "Show tproxy logs"

boot() {
	tproxy_boot=1
	start "$@"
}

to_nft_set() {
	echo "$1" | tr '\n\t,' '   ' | sed 's/  */ /g;s/^ //;s/ $//;s/ /,/g'
}

to_nft_string_set() {
	echo "$1" | tr '\n\t,' '   ' | sed 's/  */ /g;s/^ //;s/ $//;s/ /","/g;s/^/"/;s/$/"/'
}

append_list_value() {
	local value="$1"
	local var="$2"

	eval "$var=\"\${$var:+\${$var} }\$value\""
}

config_get_values() {
	local value

	eval "$1=''"
	config_list_foreach main "$2" append_list_value "$1"
	eval "value=\"\${$1}\""

	if [ -z "$value" ]; then
		config_get value main "$2" "$3"
		eval "$1=\"\$value\""
	fi
}

append_reserved_sets() {
	[ "$bypass_reserved_ip" = "1" ] || return 0

	if [ "$enable_ipv4" = "1" ]; then
		cat >> "$nft_file" <<EOF
define RESERVED_IP = {
	$(to_nft_set "$reserved_ipv4")
}

EOF
	fi

	if [ "$enable_ipv6" = "1" ]; then
		cat >> "$nft_file" <<EOF
define RESERVED_IP6 = {
	$(to_nft_set "$reserved_ipv6")
}

EOF
	fi
}

append_divert_chain() {
	[ "$enable_divert" = "1" ] || return 0

	cat >> "$nft_file" <<EOF
	chain $divert_chain_name {
		type filter hook prerouting priority $divert_priority; policy accept;
		iifname { $(to_nft_string_set "$lan_ifaces") } meta l4proto { tcp, udp } socket transparent 1 meta mark set $fwmark counter
	}

EOF
}

append_prerouting_chain() {
	cat >> "$nft_file" <<EOF
	chain $prerouting_chain_name {
		type filter hook prerouting priority $prerouting_priority; policy accept;

		meta mark $bypass_mark counter return comment "Bypass VPS/Direct"
EOF

	if [ "$bypass_wan_iface" = "1" ]; then
		cat >> "$nft_file" <<EOF
		iifname { $(to_nft_string_set "$bypass_ifaces") } counter return comment "Bypass interface"
EOF
	fi

	if [ "$bypass_reserved_ip" = "1" ] && [ "$enable_ipv4" = "1" ]; then
		cat >> "$nft_file" <<EOF
		ip daddr \$RESERVED_IP counter return
EOF
	fi

	if [ "$bypass_reserved_ip" = "1" ] && [ "$enable_ipv6" = "1" ]; then
		cat >> "$nft_file" <<EOF
		ip6 daddr \$RESERVED_IP6 counter return
EOF
	fi

	if [ "$enable_tcp" = "1" ] && [ "$enable_ipv4" = "1" ]; then
		cat >> "$nft_file" <<EOF

		meta l4proto tcp tcp dport { $(to_nft_set "$tcp_ports") } meta mark set $fwmark tproxy ip to :$tproxy_port counter
EOF
	fi

	if [ "$enable_tcp" = "1" ] && [ "$enable_ipv6" = "1" ]; then
		cat >> "$nft_file" <<EOF
		meta l4proto tcp tcp dport { $(to_nft_set "$tcp_ports") } meta mark set $fwmark tproxy ip6 to :$tproxy_port counter
EOF
	fi

	if [ "$enable_udp" = "1" ] && [ "$enable_ipv4" = "1" ]; then
		cat >> "$nft_file" <<EOF
		meta l4proto udp udp dport { $(to_nft_set "$udp_ports") } meta mark set $fwmark tproxy ip to :$tproxy_port counter
EOF
	fi

	if [ "$enable_udp" = "1" ] && [ "$enable_ipv6" = "1" ]; then
		cat >> "$nft_file" <<EOF
		meta l4proto udp udp dport { $(to_nft_set "$udp_ports") } meta mark set $fwmark tproxy ip6 to :$tproxy_port counter
EOF
	fi

	cat >> "$nft_file" <<EOF
	}

EOF
}

append_output_chain() {
	cat >> "$nft_file" <<EOF
	chain $output_chain_name {
		type route hook output priority $output_priority; policy accept;

		oif "$loopback_iface" counter return comment "Local_Traffic RETURN"
EOF

	if [ "$bypass_wan_iface" = "1" ] || [ "$bypass_wg_iface" = "1" ]; then
		cat >> "$nft_file" <<EOF
		oifname { $(to_nft_string_set "$bypass_ifaces") } counter return comment "Bypass interface RETURN"
EOF
	fi

	if [ "$bypass_wg_server_port" = "1" ]; then
		cat >> "$nft_file" <<EOF
		meta l4proto udp udp sport { $(to_nft_set "$bypass_ports") } counter return comment "Bypass source port RETURN"
EOF
	fi

	if [ "$bypass_reserved_ip" = "1" ] && [ "$enable_ipv4" = "1" ]; then
		cat >> "$nft_file" <<EOF
		ip daddr \$RESERVED_IP counter return
EOF
	fi

	if [ "$bypass_reserved_ip" = "1" ] && [ "$enable_ipv6" = "1" ]; then
		cat >> "$nft_file" <<EOF
		ip6 daddr \$RESERVED_IP6 counter return
EOF
	fi

	cat >> "$nft_file" <<EOF
		meta mark $bypass_mark counter return comment "Bypass Direct"
EOF

	if [ "$proxy_router_output" = "1" ] && [ "$enable_tcp" = "1" ]; then
		cat >> "$nft_file" <<EOF

		meta l4proto tcp tcp dport { $(to_nft_set "$tcp_ports") } meta mark set $fwmark counter
EOF
	fi

	if [ "$proxy_router_output" = "1" ] && [ "$enable_udp" = "1" ]; then
		cat >> "$nft_file" <<EOF
		meta l4proto udp udp dport { $(to_nft_set "$udp_ports") } meta mark set $fwmark counter
EOF
	fi

	cat >> "$nft_file" <<EOF
	}
EOF
}

generate_nft_rules() {
	cat > "$nft_file" <<EOF
#!/usr/sbin/nft -f

EOF

	append_reserved_sets

	cat >> "$nft_file" <<EOF
table $nft_table_family $nft_table_name {
EOF

	append_divert_chain
	append_prerouting_chain
	append_output_chain

	cat >> "$nft_file" <<EOF
}
EOF
}

load_config() {
	config_load "$CONFIG"
	config_get_bool enabled main enabled 0

	config_get prog main prog "/usr/local/bin/mihomo"
	config_get res_dir main res_dir "/etc/clash.meta"
	config_get config_file main config_file "$res_dir/config.yaml"

	config_get fwmark main fwmark "1"
	config_get bypass_mark main bypass_mark "255"
	config_get ipv4_table main ipv4_table "100"
	config_get ipv6_table main ipv6_table "101"
	config_get ipv4_rule_priority main ipv4_rule_priority "32760"
	config_get ipv6_rule_priority main ipv6_rule_priority "32765"
	config_get route_dev main route_dev "lo"

	config_get nft_file main nft_file "/tmp/tproxy-port.nft"
	config_get nft_table_family main nft_table_family "inet"
	config_get nft_table_name main nft_table_name "TPROXY"
	config_get divert_chain_name main divert_chain_name "divert"
	config_get prerouting_chain_name main prerouting_chain_name "prerouting"
	config_get output_chain_name main output_chain_name "output"
	config_get divert_priority main divert_priority "mangle - 1"
	config_get prerouting_priority main prerouting_priority "mangle"
	config_get output_priority main output_priority "mangle"
	config_get tproxy_port main tproxy_port "12345"

	config_get_values lan_ifaces lan_ifaces "br-lan"
	config_get_values bypass_ifaces bypass_ifaces ""
	if [ -z "$bypass_ifaces" ]; then
		config_get_values wan_ifaces wan_ifaces "eth0, pppoe-wan"
		config_get_values wg_ifaces wg_ifaces "wg"
		bypass_ifaces="$wan_ifaces, $wg_ifaces"
	fi
	config_get_values bypass_ports bypass_ports ""
	if [ -z "$bypass_ports" ]; then
		config_get bypass_ports main wg_server_port "54321"
	fi
	config_get loopback_iface main loopback_iface "lo"

	config_get_values tcp_ports tcp_ports "80, 443, 853, 465, 587, 993, 995"
	config_get_values udp_ports udp_ports "80, 443, 853"
	config_get_bool proxy_router_output main proxy_router_output 0

	config_get_values reserved_ipv4 reserved_ipv4 "0.0.0.0/8, 127.0.0.0/8, 172.16.0.0/12, 169.254.0.0/16, 100.64.0.0/10, 10.0.0.0/8, 192.168.0.0/16, 224.0.0.0/4, 240.0.0.0/4, 255.255.255.255"
	config_get_values reserved_ipv6 reserved_ipv6 "::/128, ::1/128, ::ffff:0.0.0.0/96, ::ffff:0:0/96, 64:ff9b::/96, 64:ff9b:1::/48, 100::/64, 2001::/32, 2001:20::/28, 2001:db8::/32, 2002::/16, dd88:88:88:88::/64, fc00::/7, fe80::/10, ff00::/8, fd10:10:10:10::/64"

	config_get_bool enable_divert main enable_divert 1
	config_get_bool enable_ipv4 main enable_ipv4 1
	config_get_bool enable_ipv6 main enable_ipv6 1
	config_get_bool enable_udp main enable_udp 1
	config_get_bool enable_tcp main enable_tcp 1
	config_get_bool bypass_reserved_ip main bypass_reserved_ip 1
	config_get_bool bypass_wan_iface main bypass_wan_iface 1
	config_get_bool bypass_wg_iface main bypass_wg_iface 1
	config_get_bool bypass_wg_server_port main bypass_wg_server_port 1

	config_get respawn_threshold main respawn_threshold "3600"
	config_get respawn_timeout main respawn_timeout "5"
	config_get respawn_retry main respawn_retry "3"
}

validate_config() {
	if [ ! -x "$prog" ]; then
		echo "Error: $prog not found or not executable"
		return 1
	fi

	if [ ! -d "$res_dir" ]; then
		echo "Error: $res_dir directory not found"
		return 1
	fi

	if [ ! -f "$config_file" ]; then
		echo "Error: $config_file configuration file not found"
		return 1
	fi

	return 0
}

add_routes() {
	[ "$enable_ipv4" = "1" ] && {
		ip rule add fwmark "$fwmark" table "$ipv4_table" priority "$ipv4_rule_priority" 2>/dev/null
		ip route add local default dev "$route_dev" table "$ipv4_table" 2>/dev/null
	}

	[ "$enable_ipv6" = "1" ] && {
		ip -6 rule add fwmark "$fwmark" table "$ipv6_table" priority "$ipv6_rule_priority" 2>/dev/null
		ip -6 route add local default dev "$route_dev" table "$ipv6_table" 2>/dev/null
	}

	logger -t tproxy "routing rules loaded"
}

del_routes() {
	[ "$enable_ipv4" = "1" ] && {
		ip rule del fwmark "$fwmark" table "$ipv4_table" priority "$ipv4_rule_priority" 2>/dev/null
		ip route del local default dev "$route_dev" table "$ipv4_table" 2>/dev/null
	}

	[ "$enable_ipv6" = "1" ] && {
		ip -6 rule del fwmark "$fwmark" table "$ipv6_table" priority "$ipv6_rule_priority" 2>/dev/null
		ip -6 route del local default dev "$route_dev" table "$ipv6_table" 2>/dev/null
	}

	logger -t tproxy "routing rules cleaned"
}

start_service() {
	if [ -n "$tproxy_boot" ]; then
		return 0
	fi

	load_config

	[ "$enabled" = "1" ] || return 0
	validate_config || return 1

	procd_open_instance
	procd_set_param command "$prog" -d "$res_dir" -f "$config_file"
	procd_set_param user root
	procd_set_param provides mihomo.tproxy
	procd_set_param limits core="unlimited"
	procd_set_param limits nofile="1000000 1000000"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn "$respawn_threshold" "$respawn_timeout" "$respawn_retry"
	procd_close_instance

	add_routes
	generate_nft_rules

	if nft -f "$nft_file"; then
		logger -t tproxy "nftables rules loaded"
	else
		logger -t tproxy "failed to load nftables rules"
		return 1
	fi

	logger -t tproxy "mihomo tproxy started"
}

stop_service() {
	load_config
	service_stop "$prog"
	del_routes

	if nft list table "$nft_table_family" "$nft_table_name" >/dev/null 2>&1; then
		nft delete table "$nft_table_family" "$nft_table_name"
		logger -t tproxy "nftables rules cleaned"
	fi

	logger -t tproxy "mihomo tproxy stopped"
}

reload_service() {
	stop
	start
}

core_version() {
	local output

	load_config

	if [ ! -x "$prog" ]; then
		echo "Not executable: $prog"
		return 1
	fi

	output="$("$prog" -v 2>&1)" && {
		echo "$output"
		return 0
	}

	output="$("$prog" -V 2>&1)" && {
		echo "$output"
		return 0
	}

	output="$("$prog" version 2>&1)" && {
		echo "$output"
		return 0
	}

	echo "$output"
	return 1
}

logs() {
	logread 2>/dev/null | grep -E "tproxy|mihomo|Clash.Meta" | tail -n 200
}

service_triggers() {
	if [ -n "$tproxy_boot" ]; then
		procd_add_raw_trigger "interface.*.up" 3000 /etc/init.d/tproxy start
	fi

	procd_add_reload_trigger "$CONFIG"
}
